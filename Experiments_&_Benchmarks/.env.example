# Copy to `.env` (repo root or this folder, depending on where you run tools) and fill keys. Never commit `.env`.
#
# Cloud: default provider is openai — use --provider anthropic for Claude (reads ANTHROPIC_API_KEY).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=
